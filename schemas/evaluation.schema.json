{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation.schema.json",
  "type": "object",
  "required": ["run_id", "item_id", "condition", "model", "rep", "criteria", "problems", "meta"],
  "properties": {
    "run_id":    { "type": "string" },
    "item_id":   { "type": "string", "pattern": "^IT-[0-9]{2,3}$" },
    "condition": { "enum": ["E0", "E1", "E2", "E3", "E4"] },
    "model":     { "type": "string" },
    "rep":       { "type": "integer", "minimum": 1 },
    "criteria": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "applicable", "label", "justification", "evidence"],
        "properties": {
          "id":            { "enum": ["C1", "C2", "C3", "C4", "C5"] },
          "applicable":    { "type": "boolean" },
          "label":         { "enum": ["A", "PA", "I", null] },
          "justification": { "type": "string", "minLength": 20 },
          "evidence":      { "type": "array" },
          "c4_expected_band": { "enum": ["low", "medium", "high", "critical", null] },
          "c4_band_distance": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 }
        }
      }
    },
    "problems": { "type": "array" },
    "meta": {
      "type": "object",
      "required": ["started_at", "duration_ms", "tokens_in", "tokens_out", "tool_calls", "prompt_hashes"]
    }
  }
}
