<!-- IT-16 | M4 | Mutante | base: IT-11 (S5/100010) -->
<!-- Defeito semeado: level_reduzido -->
<!-- level alterado de 13 para 5 (medium) -->
<!-- Resultado: tentativa root externa classificada como medium — viola P1, P2, P4 -->
<group name="syslog,sshd,acme-lab">

  <rule id="100010" level="5">
    <if_sid>5716</if_sid>
    <match>root</match>
    <srcip>!192.168.0.0/16</srcip>
    <srcip>!10.0.0.0/8</srcip>
    <srcip>!172.16.0.0/12</srcip>
    <description>Bloco 3 - Root: Tentativa de login root de IP externo fora faixas institucionais</description>
    <group>authentication_failed,external_source,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
    <!-- DEFEITO: level=5 (medium) para tentativa root externa -->
    <!-- Tabela de decisao: tentativa=medium +P2=high +P4=critical -->
    <!-- Distancia de 2 faixas do esperado = Inadequado -->
  </rule>

</group>
