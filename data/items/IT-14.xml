<!-- IT-14 | M2 | Mutante | base: IT-09 (S3/100005) -->
<!-- Defeito semeado: same_srcip_removido -->
<!-- Campo de agrupamento essencial ausente -->
<!-- Resultado: conta 10 falhas de qualquer conjunto de origens -->
<group name="syslog,sshd,acme-lab">

  <rule id="100005" level="10" frequency="10" timeframe="600">
    <if_matched_sid>100001</if_matched_sid>
    <description>Bloco 2 - Correlacao: Brute force SSH baixa-e-lenta de IP externo</description>
    <group>authentication_failed,brute_force,external_source,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
    <!-- DEFEITO: same_srcip removido -->
    <!-- Sem agrupamento por IP de origem, 10 falhas de 10 IPs diferentes -->
    <!-- disparam a regra — nao e brute force single-source -->
  </rule>

</group>
