68.0.0/16</srcip>"         },         {           "source": "xml",           "quote": "<srcip>!10.0.0.0/8</srcip>"         },         {           "source": "xml",           "quote": "<srcip>!172.16.0.0/12</srcip>"         },         {           "source": "xml",           "quote": "<description>Bloco 3 - Root: Tentativa de login root de IP externo fora faixas institucionais</description>"         }       ],       "c4_expected_band": "critical",       "c4_band_distance": 0     },     {       "id": "C5",       "applicable": true,       "label": "PA",       "justification": "A regra restringe os eventos à falha de autenticação SSH, à presença do texto root e a endereços fora das faixas internas declaradas, reduzindo o universo de correspondências. Entretanto, o match textual genérico pode incluir ocorrências não relacionadas à conta autenticada, e não existe condição adicional de contexto ou supressão de tentativas administrativas legítimas originadas externamente. O potencial de ruído é limitado, mas não eliminado.",       "evidence": [         {           "source": "xml",           "quote": "<if_sid>5716</if_sid>"         },         {           "source": "xml",           "quote": "<match>root</match>"         },         {           "source": "xml",           "quote": "<srcip>!192.168.0.0/16</srcip>"         },         {           "source": "xml",           "quote": "<srcip>!10.0.0.0/8</srcip>"         },         {           "source": "xml",           "quote": "<srcip>!172.16.0.0/12</srcip>"         }       ]     }   ],   "problems": [     {       "category": "logica_correspondencia_parcial",       "description": "A expressão textual root não está vinculada explicitamente a um campo de usuário, podendo produzir correspondências que não representam necessariamente tentativas de autenticação da conta root.",       "location": "/group/rule[@id='100010']/match"     },     {       "category": "severidade_incompativel_superescalonamento",       "description": "O nível 13 cla